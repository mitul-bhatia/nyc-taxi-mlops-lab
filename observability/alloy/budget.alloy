// Your series budget (S5, decision 017). Every series from this host passes through one of these three
// before it's sent. Grafana Cloud's free tier allows 10,000 active series for all hosts together
// (contracts/metrics.yaml). The rule: keep what a dashboard panel, an SLO or an incident would query,
// drop the rest, and drop any label whose value changes on every deploy (a new value is a new series).
//
// Rules are Prometheus relabelling (https://grafana.com/docs/alloy/latest/reference/components/prometheus/prometheus.relabel/):
//   rule { source_labels = ["__name__"]  regex = "node_(cpu|memory)_.*"  action = "keep" }
//   rule { regex = "id"  action = "labeldrop" }

declare "host" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Keep CPU, memory, load, disk space and network volume: what the host dashboard row and a "the
		// box is out of room" incident use. node_exporter exposes about a thousand series, mostly
		// per-device disk and per-interface detail nobody queries here.
		rule {
			source_labels = ["__name__"]
			regex         = "up|scrape_samples_scraped|node_cpu_seconds_total|node_load(1|5|15)|node_memory_(MemTotal|MemAvailable|MemFree|Cached|Buffers)_bytes|node_filesystem_(avail|size)_bytes|node_network_(receive|transmit)_bytes_total|node_boot_time_seconds"
			action        = "keep"
		}
		// Virtual filesystems and Docker's per-container network devices are noise, and veth names
		// change every time a container is recreated (a deploy).
		rule {
			source_labels = ["fstype"]
			regex         = "tmpfs|overlay|squashfs|devtmpfs|ramfs"
			action        = "drop"
		}

		rule {
			source_labels = ["device"]
			regex         = "lo|veth.*|br-.*|docker0"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "containers" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// cAdvisor exposes dozens of families per container. Keep CPU, memory and network: the
		// container-memory panel, and "is it being OOM-killed or starved" in an incident.
		rule {
			source_labels = ["__name__"]
			regex         = "up|scrape_samples_scraped|container_cpu_usage_seconds_total|container_memory_(working_set|usage)_bytes|container_network_(receive|transmit)_bytes_total|container_start_time_seconds"
			action        = "keep"
		}
		// id is the cgroup path, which contains the container ID, and image carries the tag (the commit
		// SHA): both change on every deploy, so every deploy would mint a whole new set of series.
		// name (lab-app-app-blue-1) is stable and is what dashboards group by.
		rule {
			regex  = "id|image"
			action = "labeldrop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "services" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// The lab's own metrics (contracts/metrics.yaml), plus the Traefik series the S8 canary will
		// compare. Everything else, such as the client libraries' python_* and process_* families and
		// Traefik's per-entrypoint and TLS series, is dropped.
		rule {
			source_labels = ["__name__"]
			regex         = "up|scrape_samples_scraped|lab_.*|traefik_service_(requests_total|request_duration_seconds_(bucket|sum|count))"
			action        = "keep"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}
